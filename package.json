{
  "name": "travel-packing-list",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "homepage": "https://flanzana.github.io/travel-packing-list",
  "scripts": {
    "predeploy": "rm -rf dist",
    "deploy": "vite build && gh-pages -d dist",
    "dev": "vite",
    "prebuild": "yarn types && yarn biome && yarn test",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "tsc",
    "biome": "biome check --error-on-warnings",
    "biome:fix": "biome check --error-on-warnings --write"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.35.0",
    "@emotion/react": "^11.14.0",
    "i18next": "^26.3.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "resize-observer-polyfill": "^1.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
